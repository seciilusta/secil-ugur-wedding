# Neon injects this automatically when connected through the Vercel Marketplace.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate both secrets independently with: openssl rand -hex 32
RSVP_ADMIN_TOKEN=replace-with-a-long-random-token
RATE_LIMIT_SECRET=replace-with-a-different-long-random-secret

RSVP_MAX_GUESTS=10
