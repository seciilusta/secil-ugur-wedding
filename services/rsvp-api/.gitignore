# This service keeps its own ignore list so it stays self-contained if the
# directory is ever moved out of the workspace.

node_modules/
dist/
coverage/
*.tsbuildinfo

.env
.env.local

# SQLite database, write-ahead log and shared-memory file. Guest data never
# belongs in version control.
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm

.DS_Store
*.log
