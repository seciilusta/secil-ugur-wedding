# Copy to .env and fill in. The service validates every value at startup and
# refuses to boot on an invalid environment.
#
#   cp .env.example .env

# Interface to bind. 0.0.0.0 accepts connections from outside the container.
HOST=0.0.0.0

# Port to listen on.
PORT=4000

# SQLite file. The parent directory is created if it does not exist, and an
# existing database is opened as-is — never replaced. In Docker, point this at
# the persistent volume: DATABASE_PATH=/data/rsvp.sqlite
DATABASE_PATH=./data/rsvp.sqlite

# Bearer token for GET /v1/rsvp/export.csv. Never expose this to the frontend.
# Generate one with: openssl rand -hex 32
RSVP_ADMIN_TOKEN=replace-with-a-long-random-token

# Authoritative maximum party size. Keep this equal to `rsvp.maxGuests` in
# apps/web/src/config/site.ts, otherwise the form offers a number this API
# rejects.
RSVP_MAX_GUESTS=10

# Comma-separated CORS allowlist of the origins that serve the website.
# Add the production origin before going live, for example:
#   WEB_ORIGINS=https://secilveugur.com,https://www.secilveugur.com
# A "*" wildcard is refused when NODE_ENV=production.
WEB_ORIGINS=http://localhost:3000

# development | test | production
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
